---
import AppShell from '../components/layout/AppShell.astro';
import VocPlaybookIsland from '../components/islands/VocPlaybookIsland';
import { getCollection } from 'astro:content';

const brandsCollection = await getCollection('brands');
const brands = brandsCollection.map(b => b.data);
---

<AppShell title="VoC Sentiment, GoFood Comments & Corridor Playbooks" activePath="/insights">
  <div class="space-y-6">
    <div class="border-b border-[var(--border-default)] pb-3">
      <h1 class="text-xl font-bold tracking-tight text-[var(--text-primary)]">
        Google Maps Review Summary, GoFood Comments &amp; Corridor Playbooks
      </h1>
      <p class="text-xs text-[var(--text-secondary)] mt-0.5">
        Direktori tervalidasi sintesis ulasan Google Maps, komentar pembeli &amp; kemasan GoFood lintas 93 brand, benchmark sewa ruko per koridor, dan playbook ekspansi modal Capex.
      </p>
    </div>

    <!-- Section 1: VoC NLP, 93-Brand Review/GoFood Directory & Playbooks Island -->
    <section>
      <VocPlaybookIsland client:load brands={brands} />
    </section>
  </div>
</AppShell>
