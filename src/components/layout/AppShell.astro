---
import '../../styles/global.css';
import MindmapModal from './MindmapModal.astro';
import DataSourcesModal from './DataSourcesModal.astro';

interface Props {
  title: string;
  description?: string;
  activePath?: string;
}

const { title, description = 'Malang Coffee Shop & Kopi Susu Market Intelligence Workstation', activePath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/', label: '1. Executive Overview', icon: 'M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z' },
  { href: '/explorer', label: '2. 93-Brand & Map Explorer', icon: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z' },
  { href: '/analytics', label: '3. OLS & Menu Lab', icon: 'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z' },
  { href: '/simulator', label: '4. Financial & Delivery P&L', icon: 'M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z' },
  { href: '/insights', label: '5. VoC Sentiment & Playbooks', icon: 'M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z' },
];

const corridorJumps = [
  { href: '/explorer?kecamatan=Lowokwaru', name: 'Lowokwaru', count: '50 Brands' },
  { href: '/explorer?kecamatan=Klojen', name: 'Klojen (Heritage)', count: '26 Brands' },
  { href: '/explorer?kecamatan=Kedungkandang+%28Sawojajar%29', name: 'Sawojajar (Haya/SWAG)', count: '6 Brands' },
  { href: '/explorer?kecamatan=Blimbing', name: 'Blimbing (Sulfat)', count: '4 Brands' },
  { href: '/explorer?kecamatan=Sukun', name: 'Sukun (Unikama)', count: '4 Brands' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Malang Coffee Intelligence</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body class="bg-[var(--bg-canvas)] text-[var(--text-primary)] min-h-screen flex flex-col antialiased">
    <!-- Top Persistent Header (Icon-Free & Minimalist) -->
    <header class="sticky top-0 z-30 h-14 bg-white/95 backdrop-blur-xs border-b border-slate-200/80 px-4 sm:px-6 flex items-center justify-between">
      <div class="flex items-center gap-2.5 sm:gap-3">
        <button
          type="button"
          id="mobile-sidebar-toggle"
          aria-label="Toggle navigation menu"
          class="md:hidden p-2 rounded-md border border-slate-200 text-slate-700 hover:text-slate-950 hover:bg-slate-50 cursor-pointer min-h-[38px] min-w-[38px] flex items-center justify-center"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <a href="/" class="flex items-center font-bold text-sm sm:text-base tracking-tight text-slate-950 hover:text-[var(--accent-base)] transition-colors">
          <span>Malang Coffee Intelligence</span>
        </a>
        <span class="hidden xl:inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono text-slate-500 bg-slate-100/80">
          93 Brands · 176 Outlets · 157 OSM POIs
        </span>
      </div>

      <!-- Icon-Free Header Actions -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <button
          type="button"
          data-open-datasources
          class="px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-md border border-emerald-300/80 bg-emerald-50 text-emerald-800 hover:bg-emerald-100 transition-colors cursor-pointer"
        >
          <span class="hidden sm:inline">Sumber Data</span>
          <span class="sm:hidden">Data</span>
        </button>

        <button
          type="button"
          data-open-mindmap
          class="px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition-colors cursor-pointer"
        >
          <span class="hidden sm:inline">Arsitektur</span>
          <span class="sm:hidden">Arsitektur</span>
        </button>

        <button
          type="button"
          id="share-btn"
          class="px-2.5 sm:px-3.5 py-1.5 text-xs font-medium rounded-md bg-[var(--accent-base)] hover:bg-[var(--accent-hover)] text-white transition-colors cursor-pointer shadow-2xs"
        >
          Share
        </button>
      </div>
    </header>

    <div class="flex-1 flex max-w-[1680px] w-full mx-auto">
      <!-- Desktop Sidebar -->
      <aside id="sidebar" class="hidden md:flex flex-col w-60 border-r border-slate-200/80 bg-[var(--bg-canvas)] p-4 shrink-0 justify-between">
        <div class="space-y-6">
          <div>
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-2">Workstation Modules</span>
            <nav class="mt-2 space-y-1">
              {navItems.map((item) => {
                const isActive = activePath === item.href || (item.href !== '/' && activePath.startsWith(item.href));
                return (
                  <a
                    href={item.href}
                    class={`flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-lg transition-all ${
                      isActive
                        ? 'bg-blue-50 text-[var(--accent-base)] font-semibold'
                        : 'text-slate-600 hover:bg-slate-200/60 hover:text-slate-900'
                    }`}
                  >
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                      <path d={item.icon} />
                    </svg>
                    <span>{item.label}</span>
                  </a>
                );
              })}
            </nav>
          </div>

          <div>
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-2">Corridor Shortcuts</span>
            <div class="mt-2 space-y-0.5">
              {corridorJumps.map((c) => (
                <a
                  href={c.href}
                  class="flex items-center justify-between px-3 py-1.5 text-xs text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg transition-colors"
                >
                  <span class="truncate">{c.name}</span>
                  <span class="text-[10px] text-slate-400 font-mono">{c.count}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 text-[11px] text-slate-400 space-y-2">
          <div>
            <p class="font-medium text-slate-700">Kota Malang Coffee Corpus</p>
            <p class="font-mono text-slate-500">OLS R² = 0.7407 · N=93</p>
          </div>
          <button
            type="button"
            data-open-datasources
            class="w-full text-left p-2 rounded-lg bg-emerald-50/70 border border-emerald-200/60 text-[10px] text-emerald-800 hover:bg-emerald-100 transition-colors flex items-center justify-between cursor-pointer"
          >
            <span>✓ Data Provenance Valid</span>
            <span class="font-mono font-bold text-emerald-700">Q1 2026</span>
          </button>
        </div>
      </aside>

      <!-- Main Analytical Canvas -->
      <main class="flex-1 p-4 sm:p-6 min-w-0 overflow-y-auto">
        <slot />
      </main>
    </div>

    <!-- Mobile Navigation Drawer Backdrop & Sheet -->
    <div
      id="mobile-drawer-backdrop"
      class="fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-40 hidden md:hidden transition-opacity"
      aria-hidden="true"
    ></div>

    <aside
      id="mobile-drawer"
      class="fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-white z-50 p-5 shadow-2xl flex flex-col justify-between transform -translate-x-full transition-transform duration-200 ease-in-out md:hidden overflow-y-auto"
      aria-label="Mobile Navigation Drawer"
    >
      <div class="space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <span class="font-bold text-sm tracking-tight text-slate-950">
            Malang Coffee Intelligence
          </span>
          <button
            type="button"
            id="mobile-drawer-close"
            class="p-1.5 rounded-md text-slate-400 hover:text-slate-800 hover:bg-slate-100 cursor-pointer min-h-[36px] min-w-[36px] flex items-center justify-center"
            aria-label="Close navigation"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-2">Workstation Modules</span>
          <nav class="mt-2 space-y-1">
            {navItems.map((item) => {
              const isActive = activePath === item.href || (item.href !== '/' && activePath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`flex items-center gap-2.5 px-3 py-2.5 text-xs font-medium rounded-lg transition-all min-h-[44px] ${
                    isActive
                      ? 'bg-blue-50 text-[var(--accent-base)] font-semibold'
                      : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
                  }`}
                >
                  <svg class="w-4 h-4 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="currentColor">
                    <path d={item.icon} />
                  </svg>
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>
        </div>

        <div>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-2">Koridor Strategis</span>
          <div class="mt-2 space-y-1">
            {corridorJumps.map((c) => (
              <a
                href={c.href}
                class="flex items-center justify-between px-3 py-2 text-xs text-slate-700 hover:text-slate-950 hover:bg-slate-100 rounded-lg transition-colors min-h-[40px]"
              >
                <span class="truncate">{c.name}</span>
                <span class="text-[10px] text-slate-400 font-mono">{c.count}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 space-y-2 text-xs">
        <button
          type="button"
          data-open-datasources
          class="w-full text-left py-2.5 px-3 rounded-lg bg-emerald-50 text-emerald-800 hover:bg-emerald-100 font-medium transition-colors min-h-[42px]"
        >
          Sumber Data &amp; Validasi (Q1 2026)
        </button>
        <button
          type="button"
          data-open-mindmap
          class="w-full text-left py-2.5 px-3 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 font-medium transition-colors min-h-[42px]"
        >
          Mindmap &amp; Arsitektur Sistem
        </button>
      </div>
    </aside>

    <!-- Mindmap Modal Component -->
    <MindmapModal />

    <!-- Data Sources & Provenance Modal Component -->
    <DataSourcesModal />

    <script>
      // Mobile Drawer Controller
      const mobileToggleBtn = document.getElementById('mobile-sidebar-toggle');
      const mobileDrawer = document.getElementById('mobile-drawer');
      const mobileBackdrop = document.getElementById('mobile-drawer-backdrop');
      const mobileDrawerClose = document.getElementById('mobile-drawer-close');

      const openMobileDrawer = () => {
        mobileDrawer?.classList.remove('-translate-x-full');
        mobileBackdrop?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      };

      const closeMobileDrawer = () => {
        mobileDrawer?.classList.add('-translate-x-full');
        mobileBackdrop?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      };

      mobileToggleBtn?.addEventListener('click', openMobileDrawer);
      mobileDrawerClose?.addEventListener('click', closeMobileDrawer);
      mobileBackdrop?.addEventListener('click', closeMobileDrawer);

      // Close mobile drawer when pressing Escape
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeMobileDrawer();
        }
      });

      // Close mobile drawer when clicking any link inside
      mobileDrawer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMobileDrawer);
      });

      // Share URL action
      const shareBtn = document.getElementById('share-btn');
      shareBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const original = shareBtn.innerHTML;
          shareBtn.innerHTML = `Tersalin!`;
          setTimeout(() => {
            shareBtn.innerHTML = original;
          }, 2000);
        } catch {
          alert(window.location.href);
        }
      });
    </script>
  </body>
</html>
