---
---

<dialog id="mindmap-modal" class="modal-operator rounded-2xl shadow-2xl max-w-4xl w-[94vw] max-h-[88dvh] overflow-hidden">
  <div class="flex flex-col max-h-[88dvh]">
    <!-- Mobile Sheet Grab Handle -->
    <div class="w-10 h-1 rounded-full bg-slate-300 mx-auto mt-2.5 sm:hidden shrink-0"></div>

    <!-- Sticky Header -->
    <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-slate-100 bg-white shrink-0">
      <div>
        <h3 class="text-sm sm:text-base font-bold text-[var(--text-primary)]">Malang Coffee Intelligence — Analytical Mindmap &amp; System Taxonomy</h3>
        <p class="text-xs text-[var(--text-muted)] mt-0.5">Verified Primary Research Corpus &amp; Econometric Architecture</p>
      </div>
      <button type="button" data-close-mindmap class="text-slate-500 hover:text-slate-900 text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer shrink-0 ml-2">
        Tutup (Esc)
      </button>
    </div>
  
    <div class="p-5 sm:p-6 overflow-y-auto overscroll-contain flex-1 text-sm space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-slate-50/80 border border-slate-200/70 p-4 rounded-xl space-y-2">
          <h4 class="font-bold text-[var(--accent-base)] text-[11px] uppercase tracking-wider">1. Data Ingestion Layer</h4>
          <ul class="text-xs text-[var(--text-secondary)] space-y-1.5 list-disc pl-4">
            <li><strong>93 Commercial Brands:</strong> 176 physical outlets, 60+ attributes per brand</li>
            <li><strong>157 OSM POIs:</strong> Live Overpass coordinates &amp; Haversine distance matrix</li>
            <li><strong>Multi-Platform Audit:</strong> Google Maps 6-Aspect Reviews + GoFood/Grab/Shopee</li>
          </ul>
        </div>

        <div class="bg-slate-50/80 border border-slate-200/70 p-4 rounded-xl space-y-2">
          <h4 class="font-bold text-[var(--accent-base)] text-[11px] uppercase tracking-wider">2. Econometric Demand</h4>
          <ul class="text-xs text-[var(--text-secondary)] space-y-1.5 list-disc pl-4">
            <li><strong>OLS Regression:</strong> R² = 0.7407 (Adj R² = 0.7258)</li>
            <li><strong>#1 Driver:</strong> ln(Google Reviews) β = +63.25 cups/day (t = +5.64)</li>
            <li><strong>24H Moat:</strong> +56.7 cups/day (t = +4.52)</li>
            <li><strong>Price Elasticity:</strong> -2.889 cups per Rp 1,000 price rise</li>
          </ul>
        </div>

        <div class="bg-slate-50/80 border border-slate-200/70 p-4 rounded-xl space-y-2">
          <h4 class="font-bold text-[var(--accent-base)] text-[11px] uppercase tracking-wider">3. Financial Monte Carlo</h4>
          <ul class="text-xs text-[var(--text-secondary)] space-y-1.5 list-disc pl-4">
            <li><strong>Format A (Booth Rp65M):</strong> ROI 335.3%, Payback 5 mo</li>
            <li><strong>Format B (Kopitiam Rp160M):</strong> ROI 418.9% (Top), Payback 4 mo</li>
            <li><strong>Format C (WFC Rp265M):</strong> ROI 227.9%, Payback 6-7 mo</li>
            <li><strong>Format D (Mega 24H Rp680M):</strong> Rp1.49B P50 Profit, Payback 6-7 mo</li>
          </ul>
        </div>
      </div>

      <div class="bg-slate-50/80 border border-slate-200/70 rounded-xl p-5 space-y-3">
        <h4 class="font-bold text-sm text-slate-900">Pilar Taksonomi 6 Kategori Pasar Malang</h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
          <div class="p-3 bg-white border border-slate-200/80 rounded-xl shadow-xs">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#0072B2] mr-1.5"></span>
            <strong class="text-slate-900">Tier 1: National Grab &amp; Go</strong>
            <p class="text-[var(--text-muted)] mt-1">Kopi Kenangan, Tomoro, Fore, Point Coffee (Kecepatan tinggi, AOV Rp18-24k)</p>
          </div>
          <div class="p-3 bg-white border border-slate-200/80 rounded-xl shadow-xs">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#D55E00] mr-1.5"></span>
            <strong class="text-slate-900">Tier 2: Local Scale Champions</strong>
            <p class="text-[var(--text-muted)] mt-1">Pesenkopi Plus, Nakoa, Dialoogi, Lafayette, Haya Espresso Bar (Sawojajar)</p>
          </div>
          <div class="p-3 bg-white border border-slate-200/80 rounded-xl shadow-xs">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#E69F00] mr-1.5"></span>
            <strong class="text-slate-900">Tier 3: Modern Kopitiam</strong>
            <p class="text-[var(--text-muted)] mt-1">Toko Kopi Kongca, Klodjen Djaja 1956, Pengyu Kopitiam (Margin 74%, tahan krisis)</p>
          </div>
          <div class="p-3 bg-white border border-slate-200/80 rounded-xl shadow-xs">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#009E73] mr-1.5"></span>
            <strong class="text-slate-900">Tier 4: 24H Mega-Hubs</strong>
            <p class="text-[var(--text-muted)] mt-1">Nakoa, Roketto, Kopi Studio 24, Semusim, Kotäsk (Volume puncak 19:00-03:00)</p>
          </div>
          <div class="p-3 bg-white border border-slate-200/80 rounded-xl shadow-xs">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#CC79A7] mr-1.5"></span>
            <strong class="text-slate-900">Tier 5: Specialty Roasteries</strong>
            <p class="text-[var(--text-muted)] mt-1">Amstirdam, 8 Oz, Common Grounds, Haya Espresso Bar (Single origin &amp; curated blend)</p>
          </div>
          <div class="p-3 bg-white border border-slate-200/80 rounded-xl shadow-xs">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#56B4E9] mr-1.5"></span>
            <strong class="text-slate-900">Tier 6: Destination &amp; Scenic</strong>
            <p class="text-[var(--text-muted)] mt-1">Bukit Delight, NK Cafe, Retrorika, Loe Mien Toe (Wisata keluarga &amp; heritage)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sticky Footer -->
    <div class="px-5 sm:px-6 py-3.5 border-t border-slate-100 bg-white flex items-center justify-between shrink-0">
      <span class="text-[11px] text-slate-500 font-mono">System Architecture · Astro 5 + React 19 Islands</span>
      <button type="button" data-close-mindmap class="px-4 py-2 rounded-lg bg-[var(--accent-base)] hover:bg-[var(--accent-hover)] text-white text-xs font-semibold transition-colors cursor-pointer">
        Selesai &amp; Tutup
      </button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('mindmap-modal') as HTMLDialogElement | null;
  const closeBtns = document.querySelectorAll('[data-close-mindmap]');
  const openTriggers = document.querySelectorAll('[data-open-mindmap]');

  openTriggers.forEach(btn => {
    btn.addEventListener('click', () => {
      dialog?.showModal();
      document.body.classList.add('overflow-hidden');
    });
  });

  closeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      dialog?.close();
    });
  });

  dialog?.addEventListener('close', () => {
    document.body.classList.remove('overflow-hidden');
  });

  dialog?.addEventListener('click', (e) => {
    const rect = dialog.getBoundingClientRect();
    const isInDialog = (
      rect.top <= e.clientY &&
      e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX &&
      e.clientX <= rect.left + rect.width
    );
    if (!isInDialog) {
      dialog.close();
    }
  });
</script>
